{
  "name": "Muelle CRM · verify and route webhooks",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "muelle-crm",
        "options": {
          "rawBody": true
        },
        "responseMode": "responseNode"
      },
      "webhookId": "5da63200-a0b7-4816-b2fd-ec9530eaf9c6",
      "name": "Muelle webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst item = $input.first();\nconst h = item.json.headers;\nconst body = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst secret = $env.MUELLE_WHSEC;\nif (!secret) return [{ json: { refused: 'Set MUELLE_WHSEC in n8n to this connection\\'s signing secret' } }];\nconst key = Buffer.from(secret.replace(/^whsec_/, ''), 'base64');\nconst expected = crypto.createHmac('sha256', key)\n  .update(`${h['webhook-id']}.${h['webhook-timestamp']}.${body}`).digest('base64');\nconst ok = (h['webhook-signature'] || '').split(' ').some((s) => s === `v1,${expected}`);\nif (!ok || Math.abs(Date.now() / 1000 - Number(h['webhook-timestamp'])) > 300) {\n  return [{ json: { refused: 'Bad signature' } }];\n}\nreturn [{ json: JSON.parse(body) }];"
      },
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.type }}",
        "rules": {
          "rules": [
            {
              "value2": "message.created"
            },
            {
              "value2": "conversation.status_changed"
            },
            {
              "value2": "lead.status_changed"
            },
            {
              "value2": "deal.status_changed"
            }
          ]
        }
      },
      "name": "Route by event",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "noData",
        "options": {
          "responseCode": 204
        }
      },
      "name": "Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Delivery is at-least-once: a retry repeats webhook-id. Drop ids this workflow already handled.\nconst id = $('Muelle webhook').first().json.headers['webhook-id'];\nconst store = $getWorkflowStaticData('global');\nconst seen = store.seenIds || [];\nif (seen.includes(id)) return [];\nseen.push(id);\nstore.seenIds = seen.slice(-1000);\nreturn $('Verify signature').all();"
      },
      "name": "Seen before?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ !$json.refused }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Signed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: $json.refused }) }}",
        "options": {
          "responseCode": 401
        }
      },
      "name": "Refuse",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        720,
        140
      ]
    }
  ],
  "connections": {
    "Muelle webhook": {
      "main": [
        [
          {
            "node": "Verify signature",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify signature": {
      "main": [
        [
          {
            "node": "Signed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Accepted": {
      "main": [
        [
          {
            "node": "Seen before?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Seen before?": {
      "main": [
        [
          {
            "node": "Route by event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Signed?": {
      "main": [
        [
          {
            "node": "Accepted",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Refuse",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "note": "Credentials: Header Auth «Authorization: token <api_key>:<api_secret>» of the connection user on the CRM calls. Env: MUELLE_WHSEC (from «Show signing secret»). See crm/docs/integrations/N8N.md."
  }
}
