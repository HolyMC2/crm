    {
      "parameters": {
        "httpMethod": "POST",
        "path": "muelle-books",
        "options": {
          "rawBody": true
        },
        "responseMode": "responseNode"
      },
      "webhookId": "3a23bc5c-db0b-4dbf-bc80-19f458216b77",
      "name": "Muelle webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Refuse instead of throwing: n8n answers 200 when a flow fails before its Respond node,\n// so a missing setting would count every event as delivered.\ntry {\n  const crypto = require('crypto');\n  const h = $input.first().json.headers;\n  const secret = $env.MUELLE_BOOKS_WHSEC;\n  if (!secret) return [{ json: { refused: \"Set MUELLE_BOOKS_WHSEC in n8n to this connection's signing secret\" } }];\n  const body = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n  const key = Buffer.from(secret.replace(/^whsec_/, ''), 'base64');\n  const expected = Buffer.from('v1,' + crypto.createHmac('sha256', key)\n    .update(`${h['webhook-id']}.${h['webhook-timestamp']}.${body}`).digest('base64'));\n  const ok = String(h['webhook-signature'] || '').split(' ').some((s) => {\n    const given = Buffer.from(s);\n    return given.length === expected.length && crypto.timingSafeEqual(given, expected);\n  });\n  if (!ok || Math.abs(Date.now() / 1000 - Number(h['webhook-timestamp'])) > 300) {\n    return [{ json: { refused: 'Bad signature' } }];\n  }\n  const event = JSON.parse(body);\n  // Delivery is at-least-once: a retry repeats webhook-id. Answer it, but do the work once.\n  const store = $getWorkflowStaticData('global');\n  const seen = store.seenIds || [];\n  if (seen.includes(h['webhook-id'])) return [{ json: { duplicate: true } }];\n  store.seenIds = [...seen.slice(-999), h['webhook-id']];\n  return [{ json: event }];\n} catch (e) {\n  return [{ json: { refused: `Cannot verify: ${e.message}` } }];\n}"
      },
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.type }}",
              "value2": "assistant.decision_pending"
            }
          ]
        }
      },
      "name": "Has buttons?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1200,
