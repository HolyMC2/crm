    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MUELLE_SITE_URL }}/api/method/doco.docoutils.assistant.api.say",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({text: $json.body.text, client_id: String($json.body.id || $execution.id)}) }}"
      },
