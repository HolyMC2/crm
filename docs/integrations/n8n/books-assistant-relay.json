{
  "name": "Muelle · books assistant relay",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "books-ask",
        "options": {
          "rawBody": true
        },
        "authentication": "headerAuth",
        "responseMode": "lastNode"
      },
      "webhookId": "fdfd6f90-9115-4cb6-9d59-a594a71b96e6",
      "name": "Ask the assistant",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MUELLE_SITE_URL }}/api/method/doco.docoutils.assistant.api.say",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({text: $json.body.text, client_id: String($json.body.id || $execution.id)}) }}"
      },
      "name": "Assistant say",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "muelle-books",
        "options": {
          "rawBody": true
        },
        "responseMode": "responseNode"
      },
      "webhookId": "3a23bc5c-db0b-4dbf-bc80-19f458216b77",
      "name": "Muelle webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst item = $input.first();\nconst h = item.json.headers;\nconst body = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst secret = $env.MUELLE_BOOKS_WHSEC;\nif (!secret) return [{ json: { refused: 'Set MUELLE_BOOKS_WHSEC in n8n to this connection\\'s signing secret' } }];\nconst key = Buffer.from(secret.replace(/^whsec_/, ''), 'base64');\nconst expected = crypto.createHmac('sha256', key)\n  .update(`${h['webhook-id']}.${h['webhook-timestamp']}.${body}`).digest('base64');\nconst ok = (h['webhook-signature'] || '').split(' ').some((s) => s === `v1,${expected}`);\nif (!ok || Math.abs(Date.now() / 1000 - Number(h['webhook-timestamp'])) > 300) {\n  return [{ json: { refused: 'Bad signature' } }];\n}\nreturn [{ json: JSON.parse(body) }];"
      },
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.type }}",
              "value2": "assistant.decision_pending"
            }
          ]
        }
      },
      "name": "Has buttons?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1200,
        240
      ]
    },
    {
      "parameters": {},
      "name": "Forward answer (replace)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        360
      ]
    },
    {
      "parameters": {},
      "name": "Ask a person to choose (replace)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        120
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "books-decide",
        "options": {
          "rawBody": true
        },
        "authentication": "headerAuth",
        "responseMode": "lastNode"
      },
      "webhookId": "8852cd45-cbe7-4e23-bd4a-79f2836e0138",
      "name": "Button chosen",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MUELLE_SITE_URL }}/api/method/doco.docoutils.assistant.api.callback",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({data: $json.body.data}) }}"
      },
      "name": "Assistant callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        240,
        480
      ]
    },
    {
      "parameters": {
        "respondWith": "noData",
        "options": {
          "responseCode": 204
        }
      },
      "name": "Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        720,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Delivery is at-least-once: a retry repeats webhook-id. Drop ids this workflow already handled.\nconst id = $('Muelle webhook').first().json.headers['webhook-id'];\nconst store = $getWorkflowStaticData('global');\nconst seen = store.seenIds || [];\nif (seen.includes(id)) return [];\nseen.push(id);\nstore.seenIds = seen.slice(-1000);\nreturn $('Verify signature').all();"
      },
      "name": "Seen before?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ !$json.refused }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Signed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        480,
        240
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: $json.refused }) }}",
        "options": {
          "responseCode": 401
        }
      },
      "name": "Refuse",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        720,
        380
      ]
    }
  ],
