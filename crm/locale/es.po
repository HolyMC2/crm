msgid "Could not grant guest access."
msgstr "No se pudo dar acceso a visitantes."

msgid "A section can have up to {0} columns"
msgstr "Una sección puede tener hasta {0} columnas"

msgid "{0} is now hidden. Set the value it should get."
msgstr "{0} ahora está oculto. Define el valor que debe recibir."

