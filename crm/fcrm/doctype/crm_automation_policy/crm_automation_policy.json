   "fieldtype": "Select",
   "label": "Status",
   "read_only": 1,
   "options": "Draft\nPublished\nPaused",
   "default": "Draft",
   "reqd": 1,
   "in_list_view": 1,
   "search_index": 1
  },
  {
   "fieldname": "revision",
   "fieldtype": "Int",
   "label": "Revision",
   "read_only": 1,
   "default": "1"
  },
  {
   "fieldname": "published_revision",
   "fieldtype": "Int",
   "label": "Published Revision",
   "read_only": 1
  },
  {
   "fieldname": "published_hash",
   "fieldtype": "Data",
   "label": "Published Hash",
   "read_only": 1,
   "length": 64
  },
  {
   "fieldname": "route_key",
   "fieldtype": "Data",
   "label": "Route Key",
   "read_only": 1,
   "hidden": 1,
   "unique": 1,
   "length": 64
  },
  {
   "fieldname": "bot_binding",
   "fieldtype": "Data",
   "label": "Bot Channel Binding",
   "read_only": 1
  },
  {
   "fieldname": "bot_profile",
   "fieldtype": "Data",
   "label": "Bot Profile",
   "read_only": 1
  },
  {
   "fieldname": "column_break_publication",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "published_by",
   "fieldtype": "Link",
   "label": "Published By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "published_at",
   "fieldtype": "Datetime",
   "label": "Published At",
   "read_only": 1
  },
  {
   "fieldname": "approval_note",
   "fieldtype": "Small Text",
   "label": "Approval Note",
   "read_only": 1
  },
  {
   "fieldname": "paused_by",
   "fieldtype": "Link",
   "label": "Paused By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "paused_at",
   "fieldtype": "Datetime",
   "label": "Paused At",
   "read_only": 1
  },
  {
   "fieldname": "pause_reason",
   "fieldtype": "Small Text",
   "label": "Pause Reason",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "report": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "report": 1
  },
  {
   "role": "Marketing Manager",
   "read": 1,
   "report": 1
  }
 ],
 "actions": [],
 "links": [],
 "states": [],
 "track_changes": 1,
 "index_web_pages_for_search": 0,
