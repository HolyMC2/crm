{
 "doctype": "DocType",
 "name": "CRM Automation Policy",
 "module": "FCRM",
 "engine": "InnoDB",
 "autoname": "hash",
 "allow_rename": 0,
 "description": "Explicit, published inbound automation for one exact customer account. Publishing pins the bot route and the published Chatflow revision; pausing revokes outstanding bot grants immediately.",
 "field_order": [
  "title",
  "provider",
  "account_id",
  "account_record",
  "column_break_route",
  "flow",
  "flow_hash",
  "department",
  "cooldown_minutes",
  "section_publication",
  "status",
  "revision",
  "published_revision",
  "published_hash",
  "route_key",
  "bot_binding",
  "bot_profile",
  "column_break_publication",
  "published_by",
  "published_at",
  "approval_note",
  "paused_by",
  "paused_at",
  "pause_reason"
 ],
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "read_only": 1,
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "provider",
   "fieldtype": "Select",
   "label": "Provider",
   "read_only": 1,
   "options": "WhatsApp\nMessenger\nInstagram\nWebchat",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "account_id",
   "fieldtype": "Data",
   "label": "Exact Account Id",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "account_record",
   "fieldtype": "Data",
   "label": "Account Record",
   "read_only": 1
  },
  {
   "fieldname": "column_break_route",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "flow",
   "fieldtype": "Data",
   "label": "Chatflow",
   "read_only": 1,
   "reqd": 1
  },
  {
   "fieldname": "flow_hash",
   "fieldtype": "Data",
   "label": "Published Flow Hash",
   "read_only": 1,
   "length": 64
  },
  {
   "fieldname": "department",
   "fieldtype": "Select",
   "label": "Fallback Department",
   "read_only": 1,
   "options": "\nmarketing\nsales\nsupport\nfinance\nwarehouse\ntechnicians"
  },
  {
   "fieldname": "cooldown_minutes",
   "fieldtype": "Int",
   "label": "Cooldown (minutes)",
   "read_only": 1,
