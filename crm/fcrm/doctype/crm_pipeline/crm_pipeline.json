  },
  {
   "fieldname": "currency",
   "label": "Default currency",
   "fieldtype": "Link",
   "options": "Currency"
  },
  {
   "fieldname": "is_default",
   "label": "Default for this company scope",
   "fieldtype": "Check",
   "default": "0"
  },
  {
   "fieldname": "archived",
   "label": "Archived",
   "fieldtype": "Check",
   "default": "0",
   "in_list_view": 1
  },
  {
   "fieldname": "probability_policy",
   "label": "Probability policy",
   "fieldtype": "Select",
   "options": "Stage\nManual\nLegacy",
   "default": "Stage",
   "reqd": 1,
   "description": "Stage: use each stage probability. Manual: preserve explicit deal probability. Legacy: preserve historical probabilities."
