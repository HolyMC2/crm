# Playwright social e2e — env contract (NAMES only). VALUES are provided at run time
# via shell export or a gitignored .env; never commit real values or host names.
CRM_BASE_URL=        # https URL of the CRM host under test (baseURL, e.g. the lab site root)
CRM_TEST_USER=       # Frappe login (email/username) with CRM + social access
CRM_TEST_PASSWORD=   # that user's password (a throwaway on lab)
W6_EVIDENCE_DIR=     # optional: dir for evidence screenshots (default: test-results/evidence)
